<style>
  .home-page {
    max-width: 1180px;
    padding: 2rem 1rem 3rem;
  }

  .home-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 4.5rem);
    border-radius: 1.25rem;
    color: #fff;
    background: linear-gradient(125deg, #071d49, #1351b4 65%, #2670d8);
  }

  .home-hero::after {
    position: absolute;
    right: -5rem;
    bottom: -11rem;
    width: 25rem;
    height: 25rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    box-shadow: 0 0 0 2.5rem rgba(255, 255, 255, 0.04), 0 0 0 5rem rgba(255, 255, 255, 0.03);
    content: "";
    pointer-events: none;
  }

  .home-hero-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .home-hero .btn {
    padding: 0.75rem 1.15rem;
  }

  body.theme-dark .home-hero .btn,
  body.theme-high-contrast .home-hero .btn {
    background-color: var(--button-primary) !important;
    border-color: var(--button-primary) !important;
    color: #03111d !important;
  }

  body.theme-dark .home-hero .btn:hover,
  body.theme-high-contrast .home-hero .btn:hover {
    background-color: var(--button-primary-hover) !important;
    border-color: var(--button-primary-hover) !important;
    color: #03111d !important;
  }

  .quick-actions .card {
    min-height: 190px;
    border: 1px solid #e5eaf2;
    border-radius: 1rem;
    box-shadow: 0 0.4rem 1.2rem rgba(15, 23, 42, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .quick-actions .card:hover,
  .quick-actions .card:focus-visible {
    transform: translateY(-4px);
    border-color: #9bb9e8;
    box-shadow: 0 0.9rem 1.8rem rgba(19, 81, 180, 0.14);
  }

  .quick-actions .card:focus-visible {
    outline: 3px solid #2670d8;
    outline-offset: 3px;
  }

  .quick-action-icon {
    display: inline-grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 1rem;
    background: #edf4ff;
    font-size: 1.8rem;
  }

  .home-faq details {
    border: 1px solid #e5eaf2 !important;
    border-radius: 0.85rem;
    transition: border-color 0.2s ease;
  }

  .home-faq details[open] {
    border-color: #b7c9e6 !important;
  }

  .home-section-title {
    border-bottom: 1px solid #e5eaf2;
    padding-bottom: 0.85rem;
  }

  @media (max-width: 575.98px) {
    .home-page {
      padding-top: 1rem;
    }

    .quick-actions .card {
      min-height: 0;
    }

    .home-hero::after {
      right: -15rem;
    }
  }
</style>
