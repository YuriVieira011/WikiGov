<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("graficoDemografico").getContext("2d");

    const graficoDemografico = new Chart(ctx, {
      type: "line",
      data: {
        labels: ["1940", "1950", "1960", "1970", "1980", "1991", "2000", "2010", "2022"],
        datasets: [
          {
            label: "Taxa Bruta de Natalidade (por mil hab.)",
            data: [44.3, 44.4, 43.3, 37.7, 31.7, 24.1, 20.9, 15.1, 12.9],
            borderColor: "rgb(231, 76, 60)",
            backgroundColor: "rgba(231, 76, 60, 0.1)",
            yAxisID: "yTaxas",
            tension: 0.2,
          },
          {
            label: "Taxa Bruta de Mortalidade (por mil hab.)",
            data: [20.9, 16.5, 14.2, 11.5, 8.8, 7.1, 6.5, 6.1, 6.9],
            borderColor: "rgb(52, 73, 94)",
            backgroundColor: "rgba(52, 73, 94, 0.1)",
            yAxisID: "yTaxas",
            tension: 0.2,
          },
          {
            label: "Expectativa de Vida ao Nascer (anos)",
            data: [45.5, 48.0, 52.5, 57.6, 62.5, 66.9, 70.5, 73.9, 75.5],
            borderColor: "rgb(39, 174, 96)",
            backgroundColor: "rgba(39, 174, 96, 0.1)",
            borderDash: [5, 5],
            yAxisID: "yExpectativa",
            tension: 0.2,
          },
        ],
      },
      options: {
        responsive: true,
        plugins: {
          title: {
            display: true,
            text: "Evolução Demográfica do Brasil (1940 - 2022)",
          },
        },
        scales: {
          yTaxas: {
            type: "linear",
            position: "left",
            title: {
              display: true,
              text: "Taxa (por mil hab.)",
            },
            beginAtZero: true,
          },
          yExpectativa: {
            type: "linear",
            position: "right",
            title: {
              display: true,
              text: "Expectativa de Vida (anos)",
            },
            grid: {
              drawOnChartArea: false, // Evita sobreposição de linhas de grade
            },
          },
        },
      },
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("graficoAnalfabetismo").getContext("2d");

    new Chart(ctx, {
      type: "line",
      data: {
        labels: ["1940", "1950", "1960", "1970", "1980", "1991", "2000", "2010", "2022"],
        datasets: [{
          label: "Taxa de Analfabetismo (%)",
          data: [56.0, 50.6, 39.6, 33.6, 25.5, 20.1, 13.6, 9.6, 7.0],
          borderColor: "rgb(231, 76, 60)",
          backgroundColor: "rgba(231, 76, 60, 0.1)",
          tension: 0.2,
          fill: true
        }]
      },
      options: {
        responsive: true,
        plugins: {
          title: {
            display: true,
            text: "Taxa de Analfabetismo - População de 15 anos ou mais (%)"
          }
        },
        scales: {
          y: { beginAtZero: true, title: { display: true, text: "%" } }
        }
      }
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("graficoSaneamento").getContext("2d");

    new Chart(ctx, {
      type: "line",
      data: {
        labels: ["1970", "1980", "1991", "2000", "2010", "2022"],
        datasets: [
          {
            label: "Abastecimento de Água Encanada (%)",
            data: [33.3, 54.9, 73.4, 77.9, 82.9, 86.6],
            borderColor: "rgb(41, 128, 185)",
            tension: 0.2
          },
          {
            label: "Coleta de Esgoto Adequada (%)",
            data: [23.2, 34.3, 47.3, 59.3, 67.1, 75.7],
            borderColor: "rgb(39, 174, 96)",
            tension: 0.2
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          title: {
            display: true,
