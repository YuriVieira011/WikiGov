        scales: {
          y: { beginAtZero: true, max: 100, title: { display: true, text: "% dos Domicílios" } }
        }
      }
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("graficoGini").getContext("2d");

