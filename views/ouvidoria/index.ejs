  <%- include("../Partials/header") %>
    <%- include("../Partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Ouvidoria</h1>
                    <p class="text-muted">
                        Lista de ouvidoria cadastradas
                    </p>
                </div>
                <a href="/ouvidoria/cadastro" class="btn btn-primary">
                    + Faça seu Chamado!
                </a>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover
                              align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Motivo</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% ouvidoria.forEach(mostrar=> { %>
                                    <tr>
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.nome%>
                                        </td>
                                        <td>
                                            <%= mostrar.motivo%>
                                        </td>
                                        <td>
                                            <a class="btn btn-success btn-sm"
                                                href="/ouvidoria/editar/<%= mostrar.id %>"
                                                >Editar</a>
                                            <a class="btn btn-warning btn-sm"
                                                href="/ouvidoria/excluir/<%= mostrar.id %>"
                                                onclick="return confirm('Deseja excluir esta categoria?')">Excluir</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../Partials/footer") %>