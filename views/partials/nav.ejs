  <!-- HEADER GOV.BR COMPLETO -->
  <header>

    <!-- 1. Barra do Governo Federal -->
    <div class="top-bar-govbr py-1">
      <div class="container d-flex justify-content-between align-items-center">
        <div>
          <a href="https://www.gov.br" target="_blank" class="fw-bold me-2">
            <i class="bi bi-flag-fill me-1"></i>WikiGov
          </a>
          <span class="d-none d-md-inline text-light opacity-75">| Enciclopédia de artigos governamentais</span>
        </div>
        <div class="top-bar-controls d-flex align-items-center gap-3">
          <button id="themeToggle" class="theme-toggle-btn" type="button" aria-label="Alternar tema" aria-pressed="false">
            <i class="bi bi-circle-half"></i>
            <span id="themeToggleLabel">Tema escuro</span>
          </button>
          <button id="contrastToggle" class="theme-toggle-btn" type="button" aria-label="Alternar alto contraste" aria-pressed="false">
            <i class="bi bi-circle-half"></i>
            <span>Alto contraste</span>
          </button>
          <a href="https://www.gov.br/pt-br" class="btn btn-govbr-login d-inline-flex align-items-center gap-2">
            <i class="bi bi-person-circle"></i>
            Acessar <strong>gov.br</strong>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Cabeçalho Principal (Nome do Órgão, Busca e Login) -->
    <div class="main-header-govbr py-3">
      <div class="container">
        <div class="row align-items-center g-3">
          
          <!-- Marca / Nome do Órgão -->
          <div class="col-12 col-md-4">
            <a href="/" class="brand-govbr d-flex align-items-center gap-2">
              <i class="bi bi-building-fill fs-3"></i>
              <div>
                <div class="lh-1">WikiGov</div>
              </div>
            </a>
          </div>

          <!-- Barra de Busca -->
<div class="col-12 col-md-7">
  <form action="/artigos" method="GET" class="row g-2">
    <div class="col-12">
      <div class="input-group">
        <input type="search" class="form-control" name="q" placeholder="O que você procura?" aria-label="Buscar artigos e serviços" value="<%= typeof busca !== 'undefined' ? busca : '' %>">
        <button class="btn btn-outline-secondary" type="submit" aria-label="Buscar artigos e serviços">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </div>
  </form>
</div>
        </div>
      </div>
    </div>

    <!-- 3. Navbar de Navegação -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-govbr p-0">
      <div class="container">
        
        <!-- Botão Hambúrguer para Mobile -->
        <button class="navbar-toggler my-2 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#menuGovBr" aria-controls="menuGovBr" aria-expanded="false" aria-label="Alternar navegação">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Itens do Menu -->
        <div class="collapse navbar-collapse" id="menuGovBr">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" aria-current="page" href="/"><i class="bi bi-house-door-fill me-1"></i> Início</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/artigos"><i class="bi bi-briefcase-fill"></i> Serviços Gov.</a>
            </li>
          </ul>
        </div>

      </div>
    </nav>

  </header>

  <!-- Bootstrap 5 JS Bundle (com Popper) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>