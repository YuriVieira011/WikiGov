<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>WikiGov</title>

  <script src="https://jsdelivr.net"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    /* Estilos Customizados com as Cores Oficiais do Gov.br */
    :root {
      --govbr-azul-escuro: #071D41;
      --govbr-azul: #1351B4;
      --gov-verde: #009639;
      --govbr-azul-hover: #0C326F;
      --govbr-amarelo: #FFCD07;
      --govbr-cinza-claro: #F8F9FA;
    }

    /* 1. Barra Superior do Governo */
    .top-bar-govbr {
      background-color: var(--govbr-azul-escuro);
      color: #ffffff;
      font-size: 0.85rem;
    }

    .top-bar-govbr a {
      color: #ffffff;
      text-decoration: none;
    }

    .top-bar-govbr a:hover {
      text-decoration: underline;
    }

    /* 2. Cabeçalho do Órgão / Marca */
    .main-header-govbr {
      background-color: #ffffff;
      border-bottom: 1px solid #E6E6E6;
    }

    .brand-govbr {
      color: var(--govbr-azul);
      font-weight: 700;
      text-decoration: none;
      font-size: 1.25rem;
    }

    .brand-govbr span {
      font-weight: 300;
      color: #555555;
    }

    /* Botão Entrar com Gov.br */
    .btn-govbr-login {
      background-color: var(--govbr-azul);
      color: #ffffff;
      font-weight: 600;
      border-radius: 20px;
      padding: 6px 18px;
    }

    .btn-govbr-login:hover {
      background-color: var(--govbr-azul-hover);
      color: #ffffff;
    }

    /* 3. Navbar Principal */
    .navbar-govbr {
      background-color: var(--govbr-azul);
      border-bottom: 4px solid var(--govbr-amarelo);
      /* Linha amarela característica */
    }

    .navbar-govbr .nav-link {
      color: #ffffff !important;
      font-weight: 500;
      padding: 0.75rem 1rem;
    }

    .navbar-govbr .nav-link:hover,
    .navbar-govbr .nav-link.active {
      background-color: var(--govbr-azul-hover);
    }

    .navbar-govbr .dropdown-menu {
      border-radius: 0;
      border: none;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .navbar-govbr .dropdown-item:hover {
      background-color: var(--govbr-cinza-claro);
      color: var(--govbr-azul);
    }
  </style>
  <script>
    // Inicializa todos os popovers da página
    document.addEventListener('DOMContentLoaded', function () {
      var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
      var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
        return new bootstrap.Popover(popoverTriggerEl)
      })
    });
  </script>
</head>

<body>