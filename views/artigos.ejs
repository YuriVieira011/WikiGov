<%- include("partials/header") %> <%- include("partials/nav") %>

    <style>
      .btn-primary {
        margin: 5px;
      }

      .service-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        border-bottom: 1px solid #e9ecef;
      }

      .service-item:last-child {
        border-bottom: none;
      }

      .service-item[hidden] {
        display: none !important;
      }

      .search-highlight {
        background-color: #fff3a3;
        color: inherit;
        padding: 0;
      }

      .term-dict {
        cursor: pointer;
        text-decoration: underline dotted;
      }
    </style>

    <div class="container mt-5">
      <main class="flex-fill" id="lista-artigos">
        <h1>Bem-vindo à página de Artigos!</h1>
        <p>
          Essa página organiza todos os artigos em um sistema simples de categorias.
        </p>
        <p id="resultado-busca" aria-live="polite" hidden></p>
        <div class="mb-3">
          <%- include("partials/agricultura") %>
          <%- include("partials/trabalho") %>
        </div>
      </main>
    </div>

    <!-- Scripts do Bootstrap e inicialização dos Popovers -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var popoverTriggerList = [].slice.call(
          document.querySelectorAll('[data-bs-toggle="popover"]'),
        );
        var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
          return new bootstrap.Popover(popoverTriggerEl);
        });

        var queryInput = document.querySelector('input[name="q"]');
        var articleList = document.getElementById("lista-artigos");
        var searchStatus = document.getElementById("resultado-busca");

        if (!queryInput || !articleList || !searchStatus) {
          return;
        }

        var details = Array.from(articleList.querySelectorAll("details"));
        var initialOpenStates = new Map(details.map(function (item) {
          return [item, item.open];
        }));
        var serviceItems = Array.from(articleList.querySelectorAll(".service-item"));
        var normalize = function (text) {
          return text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("pt-BR");
        };

        var matchesTerms = function (text, terms) {
          var normalizedText = normalize(text);
          return terms.length > 0 && terms.every(function (term) {
            return normalizedText.includes(term);
          });
        };

        var highlightTerms = function (element, terms) {
          var text = element.dataset.originalText;
          if (text === undefined) {
            text = element.textContent;
            element.dataset.originalText = text;
          }

          if (!terms.length) {
            element.textContent = text;
            return;
          }

          var normalizedText = "";
          var characterRanges = [];
          var offset = 0;

          while (offset < text.length) {
            var character = String.fromCodePoint(text.codePointAt(offset));
            var start = offset;
            offset += character.length;
            var normalizedCharacter = normalize(character);
            normalizedText += normalizedCharacter;

            for (var index = 0; index < normalizedCharacter.length; index += 1) {
              characterRanges.push({ start: start, end: offset });
            }
          }

          var ranges = [];
          terms.forEach(function (term) {
            var position = normalizedText.indexOf(term);
            while (position !== -1) {
              var endPosition = position + term.length - 1;
              ranges.push({
                start: characterRanges[position].start,
                end: characterRanges[endPosition].end
              });
              position = normalizedText.indexOf(term, position + term.length);
            }
          });

          ranges.sort(function (first, second) {
            return first.start - second.start || second.end - first.end;
          });

          var mergedRanges = [];
          ranges.forEach(function (range) {
            var previous = mergedRanges[mergedRanges.length - 1];
            if (previous && range.start <= previous.end) {
              previous.end = Math.max(previous.end, range.end);
            } else {
              mergedRanges.push({ start: range.start, end: range.end });
            }
          });

          element.replaceChildren();
          var textOffset = 0;
          mergedRanges.forEach(function (range) {
            element.appendChild(document.createTextNode(text.slice(textOffset, range.start)));
            var highlight = document.createElement("mark");
            highlight.className = "search-highlight";
            highlight.textContent = text.slice(range.start, range.end);
            element.appendChild(highlight);
            textOffset = range.end;
          });
          element.appendChild(document.createTextNode(text.slice(textOffset)));
        };

        var filterArticles = function () {
          var terms = normalize(queryInput.value.trim()).split(/\s+/).filter(Boolean);
          var matchingArticles = 0;

          details.forEach(function (item) {
            var summary = item.querySelector(":scope > summary");
            if (summary) {
              highlightTerms(summary, terms);
            }
          });

          serviceItems.forEach(function (item) {
            var title = item.querySelector("span");
            var matches = !terms.length ||
              matchesTerms(title ? title.textContent : item.textContent, terms);

            item.hidden = !matches;
            if (terms.length && title) {
              highlightTerms(title, terms);
            } else if (title) {
              highlightTerms(title, []);
            }
            if (terms.length && matchesTerms(title ? title.textContent : item.textContent, terms)) {
              matchingArticles += 1;
            }
          });

          details.slice().reverse().forEach(function (item) {
            var hasVisibleItems = Array.from(item.querySelectorAll(".service-item")).some(function (article) {
              return !article.hidden;
            });

            item.hidden = terms.length > 0 && !hasVisibleItems;
            item.open = terms.length > 0 ? !item.hidden : initialOpenStates.get(item);
          });

          searchStatus.hidden = !terms.length;
          if (terms.length) {
            var categoryCount = details.filter(function (item) {
              return !item.hidden && !item.parentElement.closest("details");
            }).length;
            searchStatus.textContent = categoryCount + (categoryCount === 1 ? " categoria e " : " categorias e ") +
              matchingArticles + (matchingArticles === 1 ? " artigo encontrado." : " artigos encontrados.");
          }
        };

        filterArticles();
        queryInput.addEventListener("input", filterArticles);
      });
    </script>

    <%- include("partials/footer") %>